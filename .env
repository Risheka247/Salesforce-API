# ── Flask ──────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
PORT=5710
HOST=0.0.0.0
ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# ── Database (PostgreSQL) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salesforce_dev
DB_USER=dev_user
DB_PASSWORD=dev_pass
DB_SCHEMA=public

# ── Salesforce ─────────────────────────────────────────
# Get these from your Salesforce Developer account:
# Setup -> Apps -> App Manager -> New Connected App
SF_CONSUMER_KEY=YOUR_CONNECTED_APP_CONSUMER_KEY
SF_PRIVATE_KEY_PEM=YOUR_RSA_PRIVATE_KEY_PEM
SF_USERNAME=your@salesforce.com
SF_LOGIN_URL=https://test.salesforce.com
SF_API_VERSION=v59.0
SF_BULK_PAGE_SIZE=50000
SF_MAX_JOB_TIMEOUT_HOURS=2

# ── Scan settings ──────────────────────────────────────
MAX_CONCURRENT_SCANS=2
SCAN_TIMEOUT_HOURS=2
CLEANUP_DAYS=7

# ── HMAC Auth (disabled in dev) ────────────────────────
HMAC_ENABLED=false
HMAC_SECRET_KEY_CORE=dev-core-key
HMAC_SECRET_KEY_ENGINEER=dev-engineer-key
HMAC_SIGNATURE_MAX_AGE=300

# ── MinIO (disabled in dev) ────────────────────────────
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=salesforce-dev

# ── Kafka (disabled in dev) ────────────────────────────
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=sf-service-dev
KAFKA_SF_CONTACTS_TOPIC=sf.contacts.dev
KAFKA_SF_ACCOUNTS_TOPIC=sf.accounts.dev
KAFKA_SF_OPPORTUNITIES_TOPIC=sf.opportunities.dev
KAFKA_SF_LEADS_TOPIC=sf.leads.dev
KAFKA_SF_ACTIVITIES_TOPIC=sf.activities.dev
KAFKA_SF_USERS_TOPIC=sf.users.dev
KAFKA_SF_CAMPAIGNS_TOPIC=sf.campaigns.dev

# ── PII Masking (disabled in dev) ──────────────────────
PII_MASKING_ENABLED=false

# ── CORS ───────────────────────────────────────────────
ALLOWED_ORIGINS=*
